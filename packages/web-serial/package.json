{
  "name": "@mhersztowski/web-serial",
  "version": "0.1.0",
  "description": "Port szeregowy i wgrywanie wsadu z przeglądarki: Web Serial API oraz esptool-js dla rodziny ESP32. Bez warstwy interfejsu — dialog należy do aplikacji.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "esptool-js": "^0.5.0"
  },
  "devDependencies": {
    "esptool-js": "^0.5.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
