{
  "name": "@mhersztowski/layout",
  "version": "0.1.0",
  "description": "Model layoutu i wymienne solvery: statyczny, kotwice, przepływ, więzy.",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./expr": {
      "import": {
        "types": "./dist/expr/index.d.ts",
        "default": "./dist/expr/index.js"
      },
      "require": {
        "types": "./dist/expr/index.d.cts",
        "default": "./dist/expr/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
