{
  "name": "@mhersztowski/texteditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mhersztowski/core": "workspace:*",
    "@xyflow/react": "^12.10.0",
    "blockly": "^12.4.1",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.28",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@mui/material": "^5.15.0 || ^6.0.0 || ^7.0.0",
    "@mui/icons-material": "^5.15.0 || ^6.0.0 || ^7.0.0",
    "@mui/x-tree-view": "^8.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "monaco-editor": ">=0.50.0",
    "@xterm/xterm": ">=5.0.0",
    "@xterm/addon-fit": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "@mui/material": { "optional": true },
    "@mui/icons-material": { "optional": true },
    "@mui/x-tree-view": { "optional": true },
    "@emotion/react": { "optional": true },
    "@emotion/styled": { "optional": true },
    "monaco-editor": { "optional": true },
    "@xterm/xterm": { "optional": true },
    "@xterm/addon-fit": { "optional": true }
  },
  "devDependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@mui/x-tree-view": "^8.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsdom": "^28.1.0",
    "monaco-editor": "^0.52.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
