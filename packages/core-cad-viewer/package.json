    "leaflet": "^1.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.0.0"
  },
  "devDependencies": {
    "@mhersztowski/core-cad": "workspace:*",
    "@mhersztowski/core-scene3d": "workspace:*",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@types/leaflet": "^1.9.14",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "leaflet": "^1.9.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-leaflet": "^4.2.1",
