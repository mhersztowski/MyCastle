# ═══════════════════════════════════════════════════════════════════
#  rover-01.hydra — plik projektu Hydra Studio
#  Źródło prawdy dla: buildu, sprzętu, symulacji i testów.
#  Generuje: platformio.ini, boards/*.hpp, sim/world.json
#  Edytowalny ręcznie i przez GUI (GUI zapisuje z zachowaniem komentarzy).
# ═══════════════════════════════════════════════════════════════════
hydra: "0.4"                 # wersja schematu pliku (migracje automatyczne)

project:
  name: rover-01
  version: 1.3.0
  description: "Łazik telemetryczny — baro + ToF + napęd różnicowy"
  authors: ["Marcin <m@example.com>"]
  license: MIT
  framework: ">=0.4.2 <0.5"  # wymagana wersja frameworka Hydra (semver)

# ── Cele sprzętowe ──────────────────────────────────────────────────
# Każdy target = środowisko PlatformIO. `board:` wskazuje plik pinów,
# który może być generowany ze schematu (patrz hardware.codegen).
targets:
  default: esp32s3-main

  esp32s3-main:
    mcu: esp32s3
    board: boards/rover_s3.hpp
    platformio: { board: esp32-s3-devkitc-1, f_cpu: 240000000 }
    memory:
      psram: opi              # off | quad | opi
      flash: 16MB
      partitions: ota_2app    # predefiniowane schematy partycji
    smp:
      pin_tasks:              # pinowanie tasków do rdzeni (ignorowane na 1-core)
        motion.control: 1
        net.worker: 0
        ui.render: 0

  pico2-dev:                  # płytka rozwojowa — bez napędu
    mcu: rp2350
    board: boards/rover_pico2.hpp
    platformio: { board: rpipico2 }
    modules: { motion: off }  # nadpisania modułów per target

  stm32-minimal:              # wariant produkcyjny bez UI
    mcu: stm32g4
    board: boards/rover_g474.hpp
    platformio: { board: nucleo_g474re }
    modules: { ui: off, net: { tls: off } }

# ── Moduły frameworka ──────────────────────────────────────────────
# Globalna konfiguracja; targets[].modules może nadpisywać.
modules:
  core:
    log:
      default: info
      per_module: { motion: debug, net: warn }
      sinks: [uart0, ringbuf]      # + rtt na stm32
      ringbuf_kb: 8
    eventbus:
      queue_depth: 32
      pool:                        # pule buforów dla dużych ładunków
        - { size: 256, count: 8 }
        - { size: 4096, count: 2 }
    watchdog: { task_timeout_ms: 5000, hw: true }
    shell: { transports: [usb, ws], history: 20 }

  sense:
    hub: { max_sensors: 16, timestamp: us }
    calibration_store: nvs         # nvs | file | none

  net:
    profile: mqtt-wifi
    hostname: "rover-01"           # + mDNS rover-01.local
    wifi:
      credentials: secrets        # NIGDY inline — patrz sekcja secrets
      fallback_ap: { ssid: "rover-01-setup", timeout_s: 300 }
    mqtt:
      broker: "mqtts://mqtt.local:8883"
      base_topic: "hydra/rover-01"
      lwt: { topic: "sys/online", payload: "0", qos: 1 }
      tls: { ca: certs/local-ca.pem }
    ota:
      channel: "https://ota.local/rover"
      verify: ed25519:keys/ota_pub.pem
      auto: false                  # tylko na żądanie z MQTT

  ui:
    backend: lvgl9
    theme: { base: dark, accent: "#e0993f", scale: 1 }
    screens: [StatusScreen, DriveScreen, SettingsScreen]
    home: StatusScreen

  motion:
    kinematics: { model: differential, wheel_mm: 68, track_mm: 142 }
    control:
      period_us: 2000              # twarda pętla 500 Hz
      deadline_policy: { miss_limit: 10, on_breach: degrade }
    safety:
      estop: { gpio: Pin.EStop, active: low }
      cmd_watchdog_ms: 250         # brak setpointu → stop
      current_limit_a: 2.5

# ── Sprzęt ─────────────────────────────────────────────────────────
# Schemat jest źródłem prawdy dla pinów; tu tylko referencja,
# parametry magistral i wiązanie komponentów z modułami.
hardware:
  schematic: hardware/rover-01.hsch
  codegen:
    boards_header: true            # .hsch → boards/*.hpp przy zapisie
    fail_on_erc: true              # błąd ERC blokuje build
  buses:
    i2c0: { hz: 400000, pullups: external, recovery: true }
    spi1: { hz: 20000000 }
    uart1: { baud: 115200, role: rs485, de_pin: Pin.Rs485De }
  components:                      # instancje → konfiguracja runtime
    baro:
      part: BMP280 @ i2c0:0x76
      hub: { period_ms: 1000, filter: "ema(0.2)", topic: sense/baro }
      measure: { mode: normal, osrs_p: x16, iir: 4 }
    tof_front:
      part: VL53L0X @ i2c0:0x29
      hub: { poll: data_ready, topic: sense/tof }
    power_mon:
      part: INA219 @ i2c0:0x40
      hub: { period_ms: 200, topic: sense/power }
      alerts: { overcurrent_a: 2.2 -> motion.derate }
    enc_l: { part: AS5600 @ i2c0:0x36, role: motion.encoder.left }
    motor_drv:
      part: DRV8833
      pins: { ain1: Pin.MotA1, ain2: Pin.MotA2, bin1: Pin.MotB1, bin2: Pin.MotB2 }
      pwm: { hz: 20000 }
    display: { part: SSD1306 @ i2c0:0x3C, role: ui.display }

# ── Symulacja ──────────────────────────────────────────────────────
simulation:
  engine: functional               # functional | qemu (S3) | renode (stm32)
  timestep_us: 1000
  sources:                         # skąd czujniki biorą dane w sim
    baro: { model: atmosphere, p_hpa: 1013.2, noise: 0.1 }
    tof_front: { model: playback, file: sim/runs/corridor.csv }
    power_mon: { model: constant, v: 7.4, a: 0.35 }
  world:
    physics: diffdrive2d           # prosty model jazdy dla motion
    arena: sim/arena/lab.json
  record: { vcd: [i2c0], eventbus: true }

# ── Testy ──────────────────────────────────────────────────────────
test:
  host:                            # poziom 1 — natywnie, mock HAL
    env: native
    sanitizers: [address, undefined]
    filter: "test_core_* test_sense_* test_motion_pid*"
  target:                          # poziom 2 — unit testy na MCU
    envs: [esp32s3-main, pico2-dev]
  hil:                             # poziom 3 — farma
    runner: proxmox-hil            # nazwa self-hosted runnera
    fixtures:
      esp32s3-main: { probe: usb-jtag, power: "uhubctl -l 1-1 -p 2", shield: selftest-v2 }
      pico2-dev:    { probe: debugprobe, power: "uhubctl -l 1-1 -p 3", shield: selftest-v2 }
    suites:
      smoke:   { on: push,    timeout_s: 120 }
      soak:    { on: nightly, duration_h: 8, monitor: [heap_hwm, stack_hwm, deadline_miss] }

# ── Sekrety ────────────────────────────────────────────────────────
# Wartości poza repo: plik lokalny lub zmienne środowiskowe CI.
secrets:
  source: .hydra-secrets.yaml      # w .gitignore
  required: [WIFI_SSID, WIFI_PASS, MQTT_USER, MQTT_PASS]

# ── Studio (ustawienia edytora — sekcja opcjonalna) ────────────────
studio:
  layout: { inspector: true, bottom_panel: 190 }
  schematic: { grid_mm: 2.54, autosave_s: 30 }
  serial_monitor: { baud: 115200, timestamps: true }
