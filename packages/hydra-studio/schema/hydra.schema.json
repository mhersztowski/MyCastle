{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-minis.dev/schema/hydra-0.4.json",
  "title": "Plik projektu Hydra (.hydra)",
  "type": "object",
  "description": "Plik projektu Hydra",
  "properties": {
    "hydra": {
      "type": "string",
      "description": "Wersja schematu pliku",
      "pattern": "^\\d+\\.\\d+$"
    },
    "project": {
      "type": "object",
      "description": "Metadane projektu",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nazwa projektu",
          "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "description": "Wersja projektu",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$"
        },
        "description": {
          "type": "string",
          "description": "Krótki opis"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Imię i adres"
          },
          "description": "Autorzy"
        },
        "license": {
          "type": "string",
          "description": "Licencja"
        },
        "framework": {
          "type": "string",
          "description": "Wymagany zakres wersji frameworka, np. \">=0.4.2 <0.5\""
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "targets": {
      "type": "object",
      "description": "Cele sprzętowe",
      "additionalProperties": {
        "type": "object",
        "description": "Cel sprzętowy — jedno środowisko budowania",
        "properties": {
          "mcu": {
            "type": "string",
            "enum": [
              "native",
              "wasm",
              "esp32",
              "esp32s2",
              "esp32s3",
              "esp32c3",
              "esp32c6",
              "rp2040",
              "rp2350",
              "stm32g4",
              "stm32f4",
              "stm32h7"
            ],
            "description": "Rodzina układu"
          },
          "board": {
            "type": "string",
            "description": "Plik pinów płytki, np. boards/rover_s3.hpp",
            "pattern": "\\.hpp$"
          },
          "platformio": {
            "type": "object",
            "description": "Odwzorowanie na środowisko PlatformIO",
            "properties": {
              "board": {
                "type": "string",
                "description": "Identyfikator płytki w PlatformIO, np. esp32-s3-devkitc-1"
              },
              "f_cpu": {
                "type": "integer",
                "description": "Taktowanie rdzenia [Hz]",
                "minimum": 1000000
              },
              "platform": {
                "type": "string",
                "description": "Wersja platformy, np. espressif32@7.0.1"
              },
              "build_src_filter": {
                "type": "string",
                "description": "Które pliki źródłowe wchodzą do celu"
              }
            },
            "additionalProperties": false,
            "required": [
              "board"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "i2c",
                "spi",
                "uart",
                "pwm",
                "adc",
                "dac",
                "wifi",
                "ble",
                "ethernet",
                "psram",
                "sdcard",
                "usb-host",
                "usb-device",
                "fpu",
                "smp",
                "can",
                "rtc"
              ],
              "description": "Możliwość"
            },
            "description": "Co ta płytka potrafi — patrz CAPABILITIES",
            "uniqueItems": true
          },
          "memory": {
            "type": "object",
            "description": "Pamięć",
            "properties": {
              "psram": {
                "type": "string",
                "enum": [
                  "off",
                  "quad",
                  "opi"
                ],
                "description": "Rodzaj pamięci PSRAM"
              },
              "flash": {
                "type": "string",
                "description": "Rozmiar pamięci Flash, np. 16MB",
                "pattern": "^\\d+(?:KB|MB|GB)$"
              },
              "partitions": {
                "type": "string",
                "enum": [
                  "single_app",
                  "huge_app",
                  "ota_2app",
                  "ota_2app_small",
                  "ota_2app_fat"
                ],
                "description": "Schemat partycji — nazwa logiczna, nie plik"
              }
            },
            "additionalProperties": false
          },
          "native": {
            "type": "object",
            "description": "Okno programu — cel `native` (pulpit) albo `wasm` (kanwa w przeglądarce)",
            "properties": {
              "display": {
                "type": "boolean",
                "description": "Czy otwierać okno; false = program bez interfejsu (CI, ssh)"
              },
              "window": {
                "type": "object",
                "description": "Powierzchnia rysowania — jej rozmiar, nie rozmiar okna",
                "properties": {
                  "width": {
                    "type": "integer",
                    "description": "Szerokość powierzchni [px]",
                    "minimum": 16,
                    "maximum": 4096
                  },
                  "height": {
                    "type": "integer",
                    "description": "Wysokość powierzchni [px]",
                    "minimum": 16,
                    "maximum": 4096
                  },
                  "scale": {
                    "type": "integer",
                    "description": "Powiększenie na ekranie; piksel bufora = kwadrat scale×scale",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "mono1",
                      "rgb565",
                      "rgb888",
                      "rgba8888"
                    ],
                    "description": "Format piksela — ten sam co panelu, który ma to zastąpić"
                  },
                  "title": {
                    "type": "string",
                    "description": "Tytuł okna; domyślnie nazwa projektu"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "smp": {
            "type": "object",
            "description": "Przydział tasków do rdzeni",
            "properties": {
              "pin_tasks": {
                "type": "object",
                "description": "Task → numer rdzenia",
                "additionalProperties": {
                  "type": "integer",
                  "description": "Numer rdzenia",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            },
            "additionalProperties": false
          },
          "modules": {
            "type": "object",
            "description": "Nadpisania modułów tylko dla tego celu",
            "additionalProperties": {
              "description": "Włączenie, wyłączenie albo nadpisanie ustawień modułu",
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "on",
                    "off"
                  ],
                  "description": "Włącz lub wyłącz moduł w całości"
                },
                {
                  "type": "boolean",
                  "description": "Włącz lub wyłącz moduł w całości"
                },
                {
                  "type": "object",
                  "description": "Nadpisania wybranych ustawień modułu",
                  "additionalProperties": {
                    "description": "Wartość ustawienia"
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "mcu"
        ]
      },
      "properties": {
        "default": {}
      }
    },
    "modules": {
      "type": "object",
      "description": "Konfiguracja modułów frameworka",
      "properties": {
        "core": {
          "type": "object",
          "description": "Rdzeń: logowanie, magistrala zdarzeń, watchdog, shell",
          "properties": {
            "log": {
              "type": "object",
              "description": "Logowanie",
              "properties": {
                "default": {
                  "type": "string",
                  "enum": [
                    "trace",
                    "debug",
                    "info",
                    "warn",
                    "error",
                    "off"
                  ],
                  "description": "Domyślny poziom"
                },
                "per_module": {
                  "type": "object",
                  "description": "Poziom dla wybranego modułu",
                  "additionalProperties": {
                    "type": "string",
                    "enum": [
                      "trace",
                      "debug",
                      "info",
                      "warn",
                      "error",
                      "off"
                    ],
                    "description": "Poziom"
                  }
                },
                "sinks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "uart0",
                      "uart1",
                      "ringbuf",
                      "rtt",
                      "usb",
                      "mqtt"
                    ],
                    "description": "Ujście"
                  },
                  "description": "Gdzie trafiają logi",
                  "uniqueItems": true
                },
                "ringbuf_kb": {
                  "type": "integer",
                  "description": "Rozmiar bufora cyklicznego [KB]",
                  "minimum": 1,
                  "maximum": 256
                }
              },
              "additionalProperties": false
            },
            "eventbus": {
              "type": "object",
              "description": "Magistrala zdarzeń",
              "properties": {
                "queue_depth": {
                  "type": "integer",
                  "description": "Głębokość skrzynki odbiorczej",
                  "minimum": 1,
                  "maximum": 1024
                },
                "pool": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "Pula",
                    "properties": {
                      "size": {
                        "type": "integer",
                        "description": "Rozmiar bufora [B]",
                        "minimum": 1
                      },
                      "count": {
                        "type": "integer",
                        "description": "Liczba buforów",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "size",
                      "count"
                    ]
                  },
                  "description": "Pule buforów dla większych ładunków"
                }
              },
              "additionalProperties": false
            },
            "watchdog": {
              "type": "object",
              "description": "Nadzorca",
              "properties": {
                "task_timeout_ms": {
                  "type": "integer",
                  "description": "Po tylu milisekundach bez oznaki życia task uznajemy za zawieszony [ms]",
                  "minimum": 1
                },
                "hw": {
                  "type": "boolean",
                  "description": "Użyj sprzętowego watchdoga układu"
                }
              },
              "additionalProperties": false
            },
            "shell": {
              "type": "object",
              "description": "Shell diagnostyczny",
              "properties": {
                "transports": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "usb",
                      "uart",
                      "ws",
                      "telnet"
                    ],
                    "description": "Kanał"
                  },
                  "description": "Kanały dostępu",
                  "uniqueItems": true
                },
                "history": {
                  "type": "integer",
                  "description": "Ile poleceń pamiętać",
                  "minimum": 0,
                  "maximum": 200
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "sense": {
          "type": "object",
          "description": "Czujniki",
          "properties": {
            "hub": {
              "type": "object",
              "description": "Odpytywanie",
              "properties": {
                "max_sensors": {
                  "type": "integer",
                  "description": "Ilu czujników najwyżej",
                  "minimum": 1,
                  "maximum": 64
                },
                "timestamp": {
                  "type": "string",
                  "enum": [
                    "ms",
                    "us"
                  ],
                  "description": "Rozdzielczość znacznika czasu"
                }
              },
              "additionalProperties": false
            },
            "calibration_store": {
              "type": "string",
              "enum": [
                "nvs",
                "file",
                "none"
              ],
              "description": "Gdzie trzymać kalibrację"
            }
          },
          "additionalProperties": false
        },
        "net": {
          "type": "object",
          "description": "Sieć",
          "properties": {
            "profile": {
              "type": "string",
              "description": "Gotowy zestaw ustawień, np. mqtt-wifi"
            },
            "hostname": {
              "type": "string",
              "description": "Nazwa urządzenia; służy też za nazwę mDNS",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "wifi": {
              "type": "object",
              "description": "Wi-Fi",
              "properties": {
                "credentials": {
                  "type": "string",
                  "description": "Skąd wziąć dane logowania — zwykle „secrets\""
                },
                "fallback_ap": {
                  "type": "object",
                  "description": "Punkt dostępowy uruchamiany, gdy nie uda się połączyć",
                  "properties": {
                    "ssid": {
                      "type": "string",
                      "description": "Nazwa sieci"
                    },
                    "timeout_s": {
                      "type": "integer",
                      "description": "Po ilu sekundach wyłączyć [s]",
                      "minimum": 10
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "ssid"
                  ]
                }
              },
              "additionalProperties": false
            },
            "mqtt": {
              "type": "object",
              "description": "MQTT",
              "properties": {
                "broker": {
                  "type": "string",
                  "description": "Adres brokera, np. mqtts://mqtt.local:8883",
                  "pattern": "^mqtts?:\\/\\/[^\\s]+$"
                },
                "base_topic": {
                  "type": "string",
                  "description": "Przedrostek tematów"
                },
                "lwt": {
                  "type": "object",
                  "description": "Testament — broker rozgłosi go, gdy urządzenie zamilknie",
                  "properties": {
                    "topic": {
                      "type": "string",
                      "description": "Temat"
                    },
                    "payload": {
                      "type": "string",
                      "description": "Treść"
                    },
                    "qos": {
                      "type": "integer",
                      "description": "Poziom dostarczenia",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "retain": {
                      "type": "boolean",
                      "description": "Czy broker ma zatrzymać ostatnią wiadomość"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "topic"
                  ]
                },
                "tls": {
                  "type": "object",
                  "description": "Szyfrowanie",
                  "properties": {
                    "ca": {
                      "type": "string",
                      "description": "Certyfikat urzędu certyfikacji w formacie PEM"
                    },
                    "client_cert": {
                      "type": "string",
                      "description": "Certyfikat urządzenia — uwierzytelnianie dwustronne"
                    },
                    "client_key": {
                      "type": "string",
                      "description": "Klucz urządzenia"
                    },
                    "insecure": {
                      "type": "boolean",
                      "description": "Wyłącz weryfikację tożsamości serwera — chroni tylko przed biernym podsłuchem"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "required": [
                "broker"
              ]
            },
            "ota": {
              "type": "object",
              "description": "Aktualizacja przez sieć",
              "properties": {
                "channel": {
                  "type": "string",
                  "description": "Adres kanału aktualizacji"
                },
                "verify": {
                  "type": "string",
                  "description": "Sposób weryfikacji wsadu, np. ed25519:keys/ota_pub.pem"
                },
                "auto": {
                  "type": "boolean",
                  "description": "Aktualizuj samoczynnie zamiast czekać na polecenie"
                }
              },
              "additionalProperties": false,
              "required": [
                "channel"
              ]
            }
          },
          "additionalProperties": false
        },
        "ui": {
          "type": "object",
          "description": "Interfejs użytkownika",
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "hydra",
                "lvgl9"
              ],
              "description": "Warstwa rysująca"
            },
            "theme": {
              "type": "object",
              "description": "Motyw",
              "properties": {
                "base": {
                  "type": "string",
                  "enum": [
                    "dark",
                    "light"
                  ],
                  "description": "Wariant"
                },
                "accent": {
                  "type": "string",
                  "description": "Kolor wyróżnienia",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "scale": {
                  "type": "number",
                  "description": "Skala interfejsu",
                  "minimum": 0.5,
                  "maximum": 4
                }
              },
              "additionalProperties": false
            },
            "screens": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Nazwa klasy ekranu"
              },
              "description": "Ekrany aplikacji",
              "uniqueItems": true
            },
            "home": {
              "type": "string",
              "description": "Ekran pokazywany po starcie"
            }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "description": "Napęd",
          "properties": {
            "kinematics": {
              "type": "object",
              "description": "Model ruchu",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "differential",
                    "ackermann",
                    "mecanum",
                    "tank"
                  ],
                  "description": "Rodzaj napędu"
                },
                "wheel_mm": {
                  "type": "number",
                  "description": "Średnica koła [mm]",
                  "minimum": 1
                },
                "track_mm": {
                  "type": "number",
                  "description": "Rozstaw kół [mm]",
                  "minimum": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "model"
              ]
            },
            "control": {
              "type": "object",
              "description": "Pętla regulacji",
              "properties": {
                "period_us": {
                  "type": "integer",
                  "description": "Okres pętli [µs]",
                  "minimum": 100,
                  "maximum": 100000
                },
                "deadline_policy": {
                  "type": "object",
                  "description": "Reakcja na przekroczenie terminu",
                  "properties": {
                    "miss_limit": {
                      "type": "integer",
                      "description": "Ile spóźnień z rzędu wolno",
                      "minimum": 1
                    },
                    "on_breach": {
                      "type": "string",
                      "enum": [
                        "ignore",
                        "degrade",
                        "stop",
                        "reboot"
                      ],
                      "description": "Co zrobić po przekroczeniu progu"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "safety": {
              "type": "object",
              "description": "Łańcuch bezpieczeństwa",
              "properties": {
                "estop": {
                  "type": "object",
                  "description": "Zatrzymanie awaryjne",
                  "properties": {
                    "gpio": {
                      "type": "string",
                      "description": "Pin, np. Pin.EStop"
                    },
                    "active": {
                      "type": "string",
                      "enum": [
                        "low",
                        "high"
                      ],
                      "description": "Stan aktywny"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "gpio"
                  ]
                },
                "cmd_watchdog_ms": {
                  "type": "integer",
                  "description": "Brak nowego zadania przez ten czas zatrzymuje napęd [ms]",
                  "minimum": 10
                },
                "current_limit_a": {
                  "type": "number",
                  "description": "Próg prądowy [A]",
                  "minimum": 0.1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "ota": {
          "type": "object",
          "description": "Aktualizacja wsadu",
          "properties": {
            "channel": {
              "type": "string",
              "description": "Adres kanału aktualizacji"
            },
            "verify": {
              "type": "string",
              "description": "Sposób weryfikacji"
            },
            "auto": {
              "type": "boolean",
              "description": "Aktualizuj samoczynnie"
            }
          },
          "additionalProperties": false
        },
        "script": {
          "type": "object",
          "description": "Skrypty i moduły WebAssembly",
          "properties": {
            "engine": {
              "type": "string",
              "enum": [
                "lua",
                "wasm3",
                "wamr"
              ],
              "description": "Silnik"
            },
            "period_ms": {
              "type": "integer",
              "description": "Co ile wołać loop() skryptu [ms]",
              "minimum": 1,
              "maximum": 60000
            },
            "budget": {
              "type": "integer",
              "description": "Limit instrukcji na przebieg",
              "minimum": 0
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "core",
                  "log",
                  "gpio",
                  "adc",
                  "pwm",
                  "i2c",
                  "event"
                ],
                "description": "Grupa"
              },
              "description": "Udostępnione grupy funkcji",
              "uniqueItems": true
            },
            "delivery": {
              "type": "object",
              "description": "Dostarczanie przez sieć",
              "properties": {
                "slot_bytes": {
                  "type": "integer",
                  "description": "Pojemność jednego slotu magazynu; slotów są dwa [B]",
                  "minimum": 256,
                  "maximum": 1048576
                },
                "persist": {
                  "type": "string",
                  "description": "Plik, w którym przetrwa wgrany obraz"
                },
                "trial_ms": {
                  "type": "integer",
                  "description": "Okres próbny nowej wersji [ms]",
                  "minimum": 0,
                  "maximum": 600000
                },
                "require_signature": {
                  "type": "boolean",
                  "description": "Przyjmuj wyłącznie podpisane obrazy"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "minis": {
          "type": "object",
          "description": "Platforma IoT MyCastle",
          "properties": {
            "user": {
              "type": "string",
              "description": "Nazwa użytkownika w MyCastle"
            },
            "heartbeat_s": {
              "type": "integer",
              "description": "Co ile wysyłać puls; 0 = tylko telemetria [s]",
              "minimum": 0,
              "maximum": 3600
            },
            "auto_register": {
              "type": "boolean",
              "description": "Czy zgłaszać się do listy urządzeń po połączeniu"
            },
            "gateway": {
              "type": "boolean",
              "description": "Tryb bramki: subskrypcje z symbolem wieloznacznym i przekazywanie ruchu urządzeń za tym"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "Łącze",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "mqtt",
                      "websocket",
                      "rs485",
                      "rs232"
                    ],
                    "description": "Rodzaj łącza"
                  },
                  "uart": {
                    "type": "integer",
                    "description": "Numer portu szeregowego",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "node": {
                    "type": "integer",
