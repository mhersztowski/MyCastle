{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EventModel",
  "definitions": {
    "EventModel": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "event"
        },
        "taskId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EventComponentModel"
          }
        }
      },
      "required": [
        "type",
        "name",
        "startTime"
      ],
      "additionalProperties": false
    },
    "EventComponentModel": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
