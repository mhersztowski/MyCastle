    "DimAnchor": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "endpoint",
            "midpoint",
            "center",
            "point-on"
          ]
        },
        "index": {
          "type": "number",
          "description": "endpoint/midpoint index, or polyline segment, or rect edge (0..3)."
        },
        "t": {
          "type": "number",
          "description": "parameter [0..1] along a segment/edge (point-on line/polyline/rect)."
        },
        "angle": {
          "type": "number",
          "description": "radians on a circle/arc (point-on circle/arc)."
        },
        "disabled": {
          "type": "boolean",
          "description": "When true the anchor is kept but ignored — the endpoint behaves as a literal point."
        }
      },
      "required": [
        "entityId",
        "kind"
      ],
      "additionalProperties": false,
      "description": "Anchors a dimension endpoint to a feature of another entity so it follows that entity when the shape moves or is reshaped (\"intelligent dimension\"). `point-on` lets the endpoint ride any point along an edge (param t / angle)."
    },
