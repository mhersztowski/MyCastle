{
  "name": "@mhersztowski/web-devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./diagrams": {
      "import": {
        "types": "./dist/diagrams/index.d.ts",
        "default": "./dist/diagrams/index.js"
      },
      "require": {
        "types": "./dist/diagrams/index.d.cts",
        "default": "./dist/diagrams/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:playground": "vite"
  },
  "devDependencies": {
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@xyflow/react": "^12.10.0",
    "jsdom": "^28.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "mermaid": "catalog:"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^18.2.0"
  }
}
