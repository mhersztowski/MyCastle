{
  "name": "@mhersztowski/sci-blocks",
  "version": "0.1.0",
  "description": "Bloki dokumentu dla bazy wiedzy: formula, sim. Widoki i panele parametrów.",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:playground": "vite",
    "export:static": "node scripts/export-static.mjs",
    "build:runtime": "node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "@mhersztowski/sci-core": "workspace:*",
    "katex": "^0.16.28",
    "mathlive": "^0.110.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^28.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.182.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
