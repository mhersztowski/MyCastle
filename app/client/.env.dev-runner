# Dev Runner — web UI for npm script management
# Run: ./run_dev_runner.sh

# Port for the web dashboard
DEV_RUNNER_PORT=1892

# Semicolon-separated absolute paths to npm project directories.
# Each directory must contain a package.json with a "scripts" section.
# Example:
# DEV_APPS=/home/user/projects/mycastle/app/mycastle-backend;/home/user/projects/mycastle/app/mycastle-web
DEV_APPS=~/myprojects/claude/MyCastle
