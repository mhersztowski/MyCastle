{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@mhersztowski/core-cad": ["../../packages/core-cad/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "index.html"],
  "exclude": ["node_modules", "dist"]
}
