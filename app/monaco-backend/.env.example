# Porty obu aplikacji Monaco. Ten plik czyta też vite.config.ts w monaco-web,
# więc zmiana portu jest w jednym miejscu.
MONACO_BACKEND_PORT=1994
MONACO_WEB_PORT=1995

# Katalog danych edytora (korzeń VFS). Ścieżka względna liczona od katalogu
# aplikacji, nie od miejsca uruchomienia.
# MONACO_DATA_DIR=./data

# Katalog biblioteki Hydra — ten z `docker/hydra.sh`. Potrzebny wyłącznie do
# budowania projektów `.hydra` z panelu Kompilacja w Hydra Studio.
#
# Hydra leży w osobnym repozytorium (MinisProjects), więc bez tej zmiennej
# backend sprawdza dwa domyślne miejsca: `../MinisProjects/libs/Hydra` obok
# monorepo oraz `git/MinisProjects/libs/Hydra` w katalogu danych.
# HYDRA_DIR=/home/user/myprojects/MinisProjects/libs/Hydra

# Obraz kontenera budującego; `hydra.sh` domyślnie bierze
# ghcr.io/platform-minis/hydra-build:latest.
#
# Cele natywne (`mcu: native` — okno na maszynie deweloperskiej) budują się
# przez CMake z SDL2, a obraz bazowy nie ma ani jednego, ani drugiego. Warstwa
# pochodna z `docker/hydra-native/` je dokłada i obsługuje też cele PlatformIO:
#   docker build -t mycastle-hydra-native:local docker/hydra-native
HYDRA_IMAGE=mycastle-hydra-native:local
