# Porty obu aplikacji Media. Ten plik czyta też vite.config.ts w media-web,
# więc zmiana portu jest w jednym miejscu.
MEDIA_BACKEND_PORT=1996
MEDIA_WEB_PORT=1997

# Katalog danych: lista odtwarzania (queue.json) i notatki (notes.json).
# Ścieżka względna liczona od katalogu aplikacji, nie od miejsca uruchomienia.
# MEDIA_DATA_DIR=./data

# Klucze Podcast Index (https://api.podcastindex.org/signup).
#
# Bez nich aplikacja działa — wyszukiwanie idzie wtedy wyłącznie przez katalog
# iTunes, który nie wymaga rejestracji. Podcast Index dokłada wyniki spoza
# ekosystemu Apple i pełniejsze opisy kanałów.
#
# Sekret nigdy nie opuszcza backendu: podpisem jest SHA-1 ze sklejenia klucza,
# sekretu i czasu uniksowego.
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# ══ Asystentka Kasia ═════════════════════════════════════════════════════════
#
# Zasada: **klucze tutaj, ustawienia w panelu.**
#
# Klucz API jest sekretem wdrożenia — zmienia się rzadko, nie powinien wędrować
# przez przeglądarkę i musi być gotowy, zanim ktokolwiek otworzy panel (na
# serwerze nie ma jak wejść w interfejs przed pierwszym uruchomieniem). Wybór
# głosu, tempa mowy czy godziny spotkania jest odwrotnie: to preferencja, którą
# zmienia się w biegu i której nie chce się wpisywać do pliku.
#
# Wpisany klucz **wybiera też dostawcę**. Nikt nie wpisuje klucza „na wszelki
# wypadek", więc ANTHROPIC_API_KEY ustawia Anthropic jako model, a
# ELEVENLABS_API_KEY — ElevenLabs jako domyślną mowę i rozpoznawanie.
#
# Bez żadnego z nich wszystko działa dalej: panel się otwiera, Kasia milczy
# i mówi wprost, czego jej brakuje. Brak jednej zmiennej nie może blokować
# startu backendu ani odtwarzacza podkastów.

# ── Model językowy ───────────────────────────────────────────────────────────
#
# Wystarczy jeden z kluczy. Gdy oba, rozstrzyga KASIA_DOSTAWCA.
# Klucz wpisany później w panelu ma pierwszeństwo nad tym z pliku — inaczej
# zmiana w interfejsie nie działałaby, dopóki ktoś nie znalazłby tego wpisu.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Jawny wybór dostawcy: anthropic | openai | ollama.
# Potrzebny tylko wtedy, gdy klucz nie wystarcza do rozstrzygnięcia — na
# przykład przy Ollamie, która działa lokalnie i klucza nie wymaga.
KASIA_DOSTAWCA=

# Nazwa modelu. Bez tego wpisu: claude-sonnet-5 / gpt-4o / llama3.2.
KASIA_MODEL=

# ── Mowa: czytanie odpowiedzi i dyktowanie ───────────────────────────────────
#
# Jeden klucz obsługuje oba kierunki — ElevenLabs robi i syntezę, i
# rozpoznawanie. Bez niego mowa idzie przez przeglądarkę (Web Speech API):
# działa bez konfiguracji, brzmi gorzej i nie na każdej przeglądarce.
#
# Klucz uzupełnia konfigurację zapisaną w panelu tam, gdzie jest ona pusta —
# dzięki temu zmiana w tym pliku działa także po tym, jak ktoś coś w panelu
# zapisał. Klucz wpisany ręcznie w panelu nie jest nadpisywany.
ELEVENLABS_API_KEY=

# ── Zachowanie ───────────────────────────────────────────────────────────────
#
# Co ile minut Kasia myśli sama i rozważa, czy się odezwać. 0 wyłącza
# inicjatywę. Bez wpisu: 5. Wchodzi tylko przy pierwszym uruchomieniu —
# potem rozstrzyga panel, żeby zmiana w interfejsie przetrwała restart.
KASIA_INICJATYWA_MIN=

# Strefa czasowa dla godzin spotkań. Bez wpisu: Europe/Warsaw.
KASIA_STREFA=

# ── Dostęp do panelu ─────────────────────────────────────────────────────────
#
# Hasło chroniące /api/kasia/* — pod tymi trasami są zadania, kalendarz, waga
# i klucze API do mowy. Reszta Media (podkasty, kolejka, notatki) zostaje
# otwarta: nie ma tam nic prywatnego.
#
# Puste = otwarte dla każdego, kto zna adres. **W sieci domowej w porządku,
# przy publicznej domenie ustaw je koniecznie.**
#
# Przeglądarka sama pokaże okno hasła (nazwa użytkownika dowolna). Skrypty mogą
# podać je nagłówkiem: Authorization: Bearer <hasło>
KASIA_HASLO=

# Dostęp do danych MyCastle — projekty, zadania, wydarzenia, kalendarz.
#
# Idzie przez **broker MQTT**, nie przez REST. Powód jest twardy: `/files/`
# w MyCastle udostępnia wyłącznie `data/public` i odpowiada 403 na resztę, także
# z ważnym tokenem. Dane PIM leżą poza tym katalogiem i cały MyCastle sięga po
# nie przez VFS po MQTT — tym samym kanałem, którego używa jego własny frontend.
#
# MYCASTLE_USER to **właściciel danych**, o które pytamy (ścieżka
# `Minis/Users/{user}/…`). Hasło jest opcjonalne: broker przepuszcza połączenie
# anonimowe, ale rozpoznaje je po tym, że nazwa i hasło są **oba** puste —
# sama nazwa bez hasła kończy się „Not authorized".
#
# Bez tych zmiennych Kasia działa, tylko nie wie nic o dniu: nie zna zadań,
# projektów ani kalendarza, i mówi o tym wprost zamiast zmyślać.
MYCASTLE_MQTT=
MYCASTLE_USER=
MYCASTLE_PASSWORD=
