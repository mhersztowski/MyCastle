# Porty obu aplikacji Media. Ten plik czyta też vite.config.ts w media-web,
# więc zmiana portu jest w jednym miejscu.
MEDIA_BACKEND_PORT=1996
MEDIA_WEB_PORT=1997

# Katalog danych: lista odtwarzania (queue.json) i notatki (notes.json).
# Ścieżka względna liczona od katalogu aplikacji, nie od miejsca uruchomienia.
# MEDIA_DATA_DIR=./data

# Klucze Podcast Index (https://api.podcastindex.org/signup).
#
# Bez nich aplikacja działa — wyszukiwanie idzie wtedy wyłącznie przez katalog
# iTunes, który nie wymaga rejestracji. Podcast Index dokłada wyniki spoza
# ekosystemu Apple i pełniejsze opisy kanałów.
#
# Sekret nigdy nie opuszcza backendu: podpisem jest SHA-1 ze sklejenia klucza,
# sekretu i czasu uniksowego.
# PODCASTINDEX_KEY=
# PODCASTINDEX_SECRET=

# ── Asystentka Kasia ─────────────────────────────────────────────────────────
#
# Bez klucza panel Kasi działa (widać spotkania, ustawienia, dostępność), ale
# sama Kasia milczy: pętla nie pyta modelu, a próba rozmowy zwraca 503 z jasnym
# komunikatem. To celowe — brak jednej zmiennej nie może blokować startu całego
# backendu ani odtwarzacza podkastów.
# ANTHROPIC_API_KEY=

# Dostęp do danych MyCastle — projekty, zadania, wydarzenia, kalendarz.
#
# Idzie przez **broker MQTT**, nie przez REST. Powód jest twardy: `/files/`
# w MyCastle udostępnia wyłącznie `data/public` i odpowiada 403 na resztę, także
# z ważnym tokenem. Dane PIM leżą poza tym katalogiem i cały MyCastle sięga po
# nie przez VFS po MQTT — tym samym kanałem, którego używa jego własny frontend.
#
# MYCASTLE_USER to **właściciel danych**, o które pytamy (ścieżka
# `Minis/Users/{user}/…`). Hasło jest opcjonalne: broker przepuszcza połączenie
# anonimowe, ale rozpoznaje je po tym, że nazwa i hasło są **oba** puste —
# sama nazwa bez hasła kończy się „Not authorized".
#
# Bez tych zmiennych Kasia działa, tylko nie wie nic o dniu: nie zna zadań,
# projektów ani kalendarza, i mówi o tym wprost zamiast zmyślać.
# MYCASTLE_MQTT=ws://localhost:1894/mqtt
# MYCASTLE_USER=marcin
# MYCASTLE_PASSWORD=
