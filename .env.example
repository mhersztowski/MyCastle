PORT=1894
MQTT_PORT=1894
ROOT_DIR=./data

# ── CLI tool Docker images ──────────────────────────────────────────────
# Backend spawns `docker run --rm <image>` for every build/deploy. Images
# are built once via `docker compose -f docker-compose.cli.yml build`.
# Leave a var unset to disable that capability (backend logs "not configured").

# Arduino CLI — sketches → .hex/.bin (esp32, avr, …)
ARDUINO_CLI_DOCKER_IMAGE=mycastle-arduino:local

# Arduino → WASM via Emscripten — required for the in-browser C++ runtime
# (CppProjectPage → "Run in browser"). Build with:
#   docker compose -f docker-compose.cli.yml build arduino-wasm
ARDUINO_WASM_DOCKER_IMAGE=mycastle-arduino-wasm:local

# MicroPython / Pico SDK / Pygame web builder
UPYTHON_DOCKER_IMAGE=mycastle-pico:local
PICOSDK_DOCKER_IMAGE=mycastle-pico:local
PYGAME_DOCKER_IMAGE=mycastle-pygame:local
