# Konfiguracja archiwizacji homelaba → Google Drive.
# Instalowana jako /etc/homelab-backup/backup.env (chmod 600, właściciel root).

# ── Repozytorium restic ────────────────────────────────────────────────────
# Backendem jest rclone, więc adres ma postać rclone:<remote>:<ścieżka>.
RESTIC_REPOSITORY="rclone:gdrive:Backups/homelab1ubuntu"
RESTIC_PASSWORD_FILE="/etc/homelab-backup/restic-password"

# Cache restica podawany jawnie z tego samego powodu co config rclone: usługa
# systemd startuje z PUSTYM $HOME, a restic bez $HOME i bez $XDG_CACHE_HOME nie
# umie zlokalizować katalogu cache i kończy błędem KAŻDE polecenie — łącznie ze
# sprawdzeniem, czy repozytorium istnieje.
export RESTIC_CACHE_DIR="/var/cache/restic"

# Config rclone podawany jawnie — usługa systemd startuje bez HOME użytkownika,
# a domyślne szukanie w ~/.config/rclone kończy się wtedy "didn't find section".
export RCLONE_CONFIG="/etc/homelab-backup/rclone.conf"

# Ograniczenie pasma wysyłki (puste = bez limitu). Format rclone, np. "5M",
# albo harmonogram "08:00,1M 23:00,off" żeby nie dławić łącza w dzień.
export RCLONE_BWLIMIT=""

# ── Pamięć ─────────────────────────────────────────────────────────────────
# Maszyna ma 3,4 GB RAM i połowę zjadają kontenery. Agresywne GC i mniejsze
# paczki trzymają restica w kilkuset MB zamiast pozwolić mu urosnąć do OOM.
export GOGC=20
export RESTIC_PACK_SIZE=16
export RESTIC_COMPRESSION=auto

# ── Katalogi robocze ───────────────────────────────────────────────────────
STAGING_DIR="/var/backups/homelab/staging"
LOG_DIR="/var/log/homelab-backup"

# ── Co archiwizujemy ───────────────────────────────────────────────────────
# Staging (dumpy baz, inwentarz, config Proxmoksa) dokładany jest automatycznie.
BACKUP_PATHS=(
  /etc
  /root
  /home
  /data/coolify
  /data/projects
  /data/users
  /data/symbols
  /data/footprints
  /data/ldraw-favorites.json
  /opt/mycastle-data
  /media/photos
  /var/lib/docker/volumes
)

EXCLUDE_FILE="/etc/homelab-backup/excludes.txt"

# ── Retencja ───────────────────────────────────────────────────────────────
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
KEEP_YEARLY=3

# prune przepisuje paczki w repozytorium, więc na zdalnym dysku kosztuje
# transfer i czas — robimy go raz w tygodniu, a nie po każdym snapshocie.
# 1=poniedziałek … 7=niedziela. Pusta wartość = prune nigdy automatycznie.
PRUNE_ON_WEEKDAY=7

# ── Proxmox (opcjonalnie) ──────────────────────────────────────────────────
# Pusty PVE_HOST wyłącza moduł. Zbierany jest wyłącznie config i inwentarz —
# obrazy dysków VM są za duże na Drive i nie są tu ruszane.
PVE_HOST=""
PVE_SSH_KEY="/etc/homelab-backup/pve_ed25519"

# ── Bazy danych ────────────────────────────────────────────────────────────
# Nazwy kontenerów pomijanych przy zrzutach, rozdzielone spacjami.
# Lista słów, nie tablica — moduły dostają ją przez środowisko.
SKIP_DB_CONTAINERS=""

# ── Powiadomienia ──────────────────────────────────────────────────────────
# Wywoływane na końcu przebiegu: NOTIFY_CMD "<ok|fail>" "<jednolinijkowe podsumowanie>"
NOTIFY_CMD=""
