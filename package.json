{
  "name": "@mhersztowski/mycastle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=2 run build",
    "build:minisc": "pnpm --filter @mhersztowski/minisc run build",
    "build:minislib": "pnpm --filter @mhersztowski/minislib run build",
    "build:server-logic": "pnpm --filter @mhersztowski/server-logic run build",
    "build:core": "pnpm --filter @mhersztowski/core run build",
    "build:core-backend": "pnpm --filter @mhersztowski/core-backend run build",
    "build:devtools": "pnpm --filter @mhersztowski/devtools run build",
    "build:texteditor": "pnpm --filter @mhersztowski/texteditor run build",
    "build:hydra-studio": "pnpm --filter @mhersztowski/hydra-studio run build",
    "build:web-client": "pnpm --filter @mhersztowski/web-client run build",
    "build:sci-core": "pnpm --filter @mhersztowski/sci-core run build",
    "build:sci-blocks": "pnpm --filter @mhersztowski/sci-blocks run build",
    "build:backend": "pnpm --filter mycastle-backend run build",
    "build:web": "pnpm --filter mycastle-web run build",
    "build:scene3d": "pnpm --filter demo-scene-3d run build",
    "build:core-cad": "pnpm --filter @mhersztowski/core-cad run build",
    "build:web-cpp": "pnpm --filter @mhersztowski/web-cpp run build",
    "build:web-devtools": "pnpm --filter @mhersztowski/web-devtools run build",
    "build:core-scene3d": "pnpm --filter @mhersztowski/core-scene3d run build",
    "build:cad-viewer": "pnpm --filter @mhersztowski/core-cad-viewer run build",
    "build:ui-scene3d": "pnpm --filter @mhersztowski/ui-components-scene3d run build",
    "build:cad": "pnpm build:core-cad && pnpm build:layout && pnpm build:texteditor && pnpm build:cad-viewer && pnpm --filter cad-app run build",
    "build:cad-backend": "pnpm --filter cad-backend run build",
    "build:monaco-backend": "pnpm --filter monaco-backend run build",
    "build:monaco-web-deps": "pnpm build:core && pnpm build:texteditor && pnpm build:hydra-studio",
    "build:monaco-web": "pnpm build:monaco-web-deps && pnpm --filter monaco-web run build",
    "build:monaco": "pnpm build:monaco-web-deps && pnpm build:core-backend && pnpm build:monaco-backend && pnpm --filter monaco-web run build",
    "build:ui-core": "pnpm --filter @mhersztowski/ui-core run build",
    "build:cad-all": "pnpm build:core && pnpm build:core-cad && pnpm build:ui-core && pnpm build:core-scene3d && pnpm build:cad-viewer && pnpm build:ui-scene3d && pnpm build:texteditor && pnpm build:layout && pnpm build:cad-backend && pnpm build:cad",
    "build:cadall": "pnpm build:cad-all",
    "build:mycastle": "pnpm build:core && pnpm build:core-backend && pnpm build:minisc && pnpm build:minislib && pnpm build:server-logic && pnpm build:devtools && pnpm build:texteditor && pnpm build:web-client && pnpm build:web-cpp && pnpm build:web-devtools && pnpm build:core-cad && pnpm build:ui-core && pnpm build:core-scene3d && pnpm build:cad-viewer && pnpm build:layout && pnpm build:sci-core && pnpm build:sci-blocks && pnpm build:backend && pnpm build:web",
    "dev:mycastle": "concurrently -n backend,web -c blue,green --kill-others \"pnpm dev:backend\" \"pnpm dev:web\"",
    "dev:backend": "pnpm --filter mycastle-backend run dev",
    "dev:web": "pnpm --filter mycastle-web run dev",
    "dev:scene3d": "pnpm --filter demo-scene-3d run dev",
    "dev:cad": "concurrently -n cad-backend,cad-app -c cyan,green --kill-others \"pnpm dev:cad-backend\" \"pnpm dev:cad-app\"",
    "dev:cad-app": "pnpm --filter cad-app run dev",
    "dev:cad-backend": "pnpm --filter cad-backend run dev",
    "dev:monaco": "concurrently -n monaco-backend,monaco-web -c magenta,green --kill-others \"pnpm dev:monaco-backend\" \"pnpm dev:monaco-web\"",
    "dev:monaco-backend": "pnpm --filter monaco-backend run dev",
    "dev:monaco-web": "pnpm --filter monaco-web run dev",
    "dev:trail-map": "pnpm --filter trail-map run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "pnpm -r exec rm -rf dist build",
    "typecheck": "pnpm -r run typecheck",
    "gendocs": "typedoc",
    "gendocs:html": "typedoc --html docs-site/html",
    "gendocs:md": "typedoc --out docs-site/markdown",
    "sync:push": "./scripts/sync.sh push",
    "sync:push:force": "./scripts/sync.sh push --force",
    "sync:pull": "./scripts/sync.sh pull",
    "sync:pull:force": "./scripts/sync.sh pull --force",
    "sync:db-push": "./scripts/sync.sh db-push",
    "sync:db-pull": "./scripts/sync.sh db-pull",
    "sync:backup": "./scripts/sync.sh backup",
    "sync:backup-list": "./scripts/sync.sh backup-list",
    "build:layout": "pnpm --filter @mhersztowski/layout run build",
    "fix:node-pty": "bash scripts/fix-node-pty-permissions.sh",
    "postinstall": "bash scripts/fix-node-pty-permissions.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.2",
    "typedoc": "^0.28.4",
    "typedoc-plugin-markdown": "^4.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty"
    ],
    "patchedDependencies": {
      "three@0.182.0": "patches/three@0.182.0.patch"
    }
  }
}
