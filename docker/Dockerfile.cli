# Multi-stage CLI image for Minis tools
# Build targets: arduino, pico, pygame
# Usage: docker compose -f docker-compose.cli.yml build

# ─── Shared base ────────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    ca-certificates \
    unzip \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["tail", "-f", "/dev/null"]


# ─── Arduino CLI ────────────────────────────────────────────────────────────
FROM base AS arduino

# build-essential needed by some Arduino cores at compile time
# python3-serial + pip pyserial both needed: apt for system tools, pip for esptool.py
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-serial \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --no-cache-dir pyserial

# Override at build time: --build-arg ARDUINO_ARCH=Linux_ARM64
ARG ARDUINO_ARCH=Linux_64bit

RUN curl -L https://github.com/arduino/arduino-cli/releases/download/v1.4.1/arduino-cli_1.4.1_${ARDUINO_ARCH}.tar.gz \
        -o /tmp/arduino-cli.tar.gz \
    && tar -xzf /tmp/arduino-cli.tar.gz -C /tmp \
    && mv /tmp/arduino-cli /usr/local/bin/ \
    && rm /tmp/arduino-cli.tar.gz

RUN arduino-cli core update-index \
    && arduino-cli config init \
    && arduino-cli config add board_manager.additional_urls https://arduino.esp8266.com/stable/package_esp8266com_index.json \
    && arduino-cli config add board_manager.additional_urls https://espressif.github.io/arduino-esp32/package_esp32_index.json \
    && arduino-cli core update-index \
    && arduino-cli core install arduino:avr@1.8.7 \
    && arduino-cli core install esp8266:esp8266@3.1.2 \
    && arduino-cli core install esp32:esp32@3.0.7 \
    && mv /root/.arduino15 /opt/arduino15 \
    && chmod -R a+rwX /opt/arduino15

# Point arduino-cli at the shared data dir so any uid/gid can use the baked-in cores
ENV ARDUINO_DIRECTORIES_DATA=/opt/arduino15


# ─── Raspberry Pi Pico / MicroPython ────────────────────────────────────────
FROM base AS pico

# build tools (cmake, make, xz for toolchain extraction)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Official ARM GNU Toolchain — includes gcc, g++, newlib, C++ stdlib headers
# Works on both x86_64 and aarch64 hosts (Ubuntu packages are incomplete on ARM64)
ARG ARM_TOOLCHAIN_VER=13.3.rel1
ARG ARM_TOOLCHAIN_ARCH=aarch64
RUN curl -L "https://developer.arm.com/-/media/Files/downloads/gnu/${ARM_TOOLCHAIN_VER}/binrel/arm-gnu-toolchain-${ARM_TOOLCHAIN_VER}-${ARM_TOOLCHAIN_ARCH}-arm-none-eabi.tar.xz" \
        -o /tmp/arm-toolchain.tar.xz \
    && tar -xf /tmp/arm-toolchain.tar.xz -C /opt \
    && rm /tmp/arm-toolchain.tar.xz \
    && mv /opt/arm-gnu-toolchain-${ARM_TOOLCHAIN_VER}-${ARM_TOOLCHAIN_ARCH}-arm-none-eabi /opt/arm-toolchain

ENV PATH="/opt/arm-toolchain/bin:${PATH}"

# mpremote for deploying MicroPython scripts over serial
# (USB serial passthrough: add `devices: [/dev/ttyUSB0:/dev/ttyUSB0]` in compose)
RUN pip3 install --break-system-packages --no-cache-dir mpremote

# Pico SDK baked into image — server won't have it locally
# Symlink fixes pico-sdk 2.x bug: cmake looks for rp2350.cmake, file is rp2350-arm-s.cmake
ARG PICO_SDK_TAG=2.1.1
RUN git clone --depth=1 --branch ${PICO_SDK_TAG} \
        https://github.com/raspberrypi/pico-sdk.git /opt/pico-sdk \
    && cd /opt/pico-sdk && git submodule update --init \
    && ln -s /opt/pico-sdk/src/rp2350-arm-s.cmake /opt/pico-sdk/src/rp2350.cmake

ENV PICO_SDK_PATH=/opt/pico-sdk


# ─── Arduino → WebAssembly (Emscripten) ──────────────────────────────────────
FROM ubuntu:22.04 AS arduino-wasm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install emsdk from source — supports both linux/amd64 and linux/arm64 natively
RUN git clone --depth 1 https://github.com/emscripten-core/emsdk.git /emsdk \
    && cd /emsdk \
    && ./emsdk install 3.1.74 \
    && ./emsdk activate 3.1.74

ENV EMSDK=/emsdk
ENV PATH="/emsdk/upstream/emscripten:/emsdk/upstream/bin:${PATH}"

WORKDIR /workspace

# Kopia mocka jako fallback dla deploymentu, gdzie repo nie jest dostępne.
# Przy pracy lokalnej backend montuje `docker/arduino-mock/` przez `-v` (patrz
# ArduinoWasmBuilder), więc zmiany w mocku działają bez przebudowy obrazu.
COPY docker/arduino-mock/ /arduino-mock/

CMD ["tail", "-f", "/dev/null"]


# ─── Pygame / pygbag web builder ─────────────────────────────────────────────
FROM base AS pygame

# ffmpeg: audio/video asset processing by pygbag
# black: Python formatter used by pygbag optimizer
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# pygbag converts pygame projects to WebAssembly — headless, no display needed
RUN pip3 install --break-system-packages --no-cache-dir pygbag pygame black


# ─── Hydra → WebAssembly ─────────────────────────────────────────────────────
#
# Warstwa pochodna nad `arduino-wasm`, a nie osobna instalacja emsdk: emsdk waży
# ~2 GB i jest dokładnie tym samym kompilatorem, którego używa budowanie szkiców
# Arduino. Tu dochodzi wyłącznie CMake, bo Hydra buduje cel natywny właśnie nim
# (`emit/cmake.ts`), a szkice Arduino idą prosto przez `emcc` i CMake im do
# niczego nie był potrzebny.
#
# SDL2 nie jest dokładane świadomie: emscripten ma własny port (`-sUSE_SDL=2`),
# który pobiera się przy pierwszym użyciu i jest budowany pod WebAssembly.
# Pakiet `libsdl2-dev` z Ubuntu jest dla architektury hosta i tutaj byłby
# nie tylko zbędny, ale mylący — CMake mógłby go znaleźć zamiast portu.
FROM arduino-wasm AS hydra-wasm

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    ninja-build \
    make \
    && rm -rf /var/lib/apt/lists/*

# Port SDL2 wbudowany w obraz, a cache zapisywalny dla dowolnego uid.
#
# Dwa powody, oba wychodzą dopiero przy pierwszej budowie projektu:
#
#  1. `hydra.sh` uruchamia kontener z `--user $(id -u):$(id -g)`, żeby pliki
#     wyniku należały do użytkownika, a nie do root. Cache emsdk powstaje przy
#     instalacji jako root, więc bez `chmod` kompilator przerywa na
#     „cache directory is not writable" — i to przy każdym pliku z osobna,
#     więc komunikat tonie w setce identycznych.
#  2. Kompilacja portu SDL2 przy pierwszym użyciu to kilka sekund i kilkaset
#     plików. Raz w obrazie zamiast raz na projekt.
RUN embuilder build sdl2 \
    && chmod -R a+rwX /emsdk/upstream/emscripten/cache

CMD ["tail", "-f", "/dev/null"]
