# Android build image for MyCastle Mobile (React Native / Expo)
# Usage: docker compose -f docker-compose.cli.yml build android
# Build APK: docker compose -f docker-compose.cli.yml run --rm android /workspace/app/mycastle-mobile/build.sh

FROM ubuntu:24.04

ARG ANDROID_SDK_VERSION=9477386
ARG ANDROID_SDK_URL=https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_SDK_VERSION}_latest.zip
ARG NODE_VERSION=20

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=${PATH}:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/34.0.0:/usr/local/bin

# Enable amd64 multiarch so x86_64 binaries (aapt2 etc.) can run via QEMU on ARM64.
# Ubuntu 24.04 uses DEB822 format (.sources) which has no Architectures field by default,
# so apt tries to fetch amd64 from ports.ubuntu.com (which only serves ARM). Fix: remove the
# DEB822 file entirely and replace with classic sources.list with explicit [arch=] per entry.
RUN dpkg --add-architecture amd64 \
    && rm -f /etc/apt/sources.list.d/ubuntu.sources \
    && printf '%s\n' \
       'deb [arch=arm64,armhf] http://ports.ubuntu.com/ubuntu-ports noble main restricted universe multiverse' \
       'deb [arch=arm64,armhf] http://ports.ubuntu.com/ubuntu-ports noble-updates main restricted universe multiverse' \
       'deb [arch=arm64,armhf] http://ports.ubuntu.com/ubuntu-ports noble-backports main restricted universe multiverse' \
       'deb [arch=arm64,armhf] http://ports.ubuntu.com/ubuntu-ports noble-security main restricted universe multiverse' \
       'deb [arch=amd64] http://archive.ubuntu.com/ubuntu noble main restricted universe multiverse' \
       'deb [arch=amd64] http://archive.ubuntu.com/ubuntu noble-updates main restricted universe multiverse' \
       'deb [arch=amd64] http://archive.ubuntu.com/ubuntu noble-backports main restricted universe multiverse' \
       'deb [arch=amd64] http://security.ubuntu.com/ubuntu noble-security main restricted universe multiverse' \
       > /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    ca-certificates \
    unzip \
    openjdk-17-jdk \
    python3 \
    qemu-user-static \
    # x86_64 shared libraries needed by aapt2 running under QEMU
    libc6:amd64 \
    libstdc++6:amd64 \
    zlib1g:amd64 \
    && rm -rf /var/lib/apt/lists/*

# Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Android command-line tools
RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools \
    && curl -fsSL "$ANDROID_SDK_URL" -o /tmp/commandlinetools.zip \
    && unzip /tmp/commandlinetools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools \
    && mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest \
    && rm /tmp/commandlinetools.zip

# Set JAVA_HOME dynamically after install, then run sdkmanager
RUN export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java)))) \
    && export PATH=$JAVA_HOME/bin:$PATH \
    && yes | sdkmanager --sdk_root=${ANDROID_SDK_ROOT} --licenses >/dev/null 2>&1 || true \
    && sdkmanager --sdk_root=${ANDROID_SDK_ROOT} \
        "platform-tools" \
        "platforms;android-34" \
        "build-tools;34.0.0" \
        "cmake;3.22.1" \
        # expo-modules-core (C++/JSI) requires the NDK. Pre-install it here so Gradle does not
        # try to auto-download it mid-build — that download is unreliable (truncated/corrupt zip,
        # "Archive is not a ZIP archive"), especially under QEMU x86_64 emulation on ARM64 hosts.
        "ndk;26.1.10909125"

# Persist JAVA_HOME for runtime
RUN echo "export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))" >> /etc/environment

WORKDIR /workspace
CMD ["tail", "-f", "/dev/null"]
